<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ORTech - <%= producto ? 'Editar' : 'Nuevo' %> Producto</title>
    <link rel="stylesheet" href="/estilos.css">
</head>
<body>
    <header>
        <h2>ORTech - Administración</h2>
        <span>Alumno: Lucas Ortellado</span>
    </header>

    <div class="caja-centrada" style="max-width: 500px; text-align: left;">
        <h2 style="text-align: center; margin-bottom: 15px;">
            <%= producto ? 'Editar Producto' : 'Agregar Nuevo Producto' %>
        </h2>

        <form action="<%= producto ? '/admin/productos/editar/' + producto.id : '/admin/productos/nuevo' %>" method="POST" enctype="multipart/form-data">
            <label>Nombre del Producto:</label>
            <input type="text" name="nombre" value="<%= producto ? producto.nombre : '' %>" required>

            <label>Precio ($):</label>
            <input type="number" step="0.01" name="precio" value="<%= producto ? producto.precio : '' %>" required>

            <label>Categoría:</label>
            <select name="categoria" required>
                <option value="componentes" <%= (producto && producto.categoria === 'componentes') ? 'selected' : '' %>>Componentes</option>
                <option value="perifericos" <%= (producto && producto.categoria === 'perifericos') ? 'selected' : '' %>>Periféricos</option>
            </select>

            <label>Imagen del Producto:</label>
            <input type="file" name="imagen" accept="image/*">

            <div style="margin-top: 20px; display: flex; justify-content: space-between;">
                <a href="/admin/dashboard" class="btn btn-secundario">Cancelar</a>
                <button type="submit">Guardar Producto</button>
            </div>
        </form>
    </div>
</body>
</html>